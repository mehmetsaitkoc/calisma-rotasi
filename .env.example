# Template only. Never commit real secrets. Node 24 is required.
# Local development defaults to work/local-data/rota.sqlite.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# PRODUCTION REQUIRED: externally mounted durable storage outside the checkout.
# Provisioning a paid Render disk is a separate release step.
# NODE_ENV=production
# ROTA_DB_PATH=/var/data/calisma-rotasi/accounts.sqlite
# ROTA_APP_ORIGIN=https://your-app.example
# Exact extra origins only. Android uses https://localhost; no wildcards.
ROTA_ALLOWED_ORIGINS=
# ROTA_ALLOWED_ORIGINS=https://localhost
# Enable only behind a trusted proxy that overwrites the client-IP header.
ROTA_TRUST_PROXY=0

# Server-only secret. Empty key means honest unavailable responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ROTA_AI_PROFILE=economy
ROTA_AI_MODEL=gpt-5.6-luna
ROTA_ALLOW_PREMIUM=0
# Optional model-supported value; GPT-6 Astra cannot use none.
# ROTA_AI_REASONING_EFFORT=low
ROTA_TTS_MODEL=gpt-4o-mini-tts
ROTA_TTS_MALE_VOICE=cedar
ROTA_TTS_FEMALE_VOICE=marin
ROTA_PROVIDER_TIMEOUT_MS=45000

# Sessions: 7 days; opaque tokens are stored only as hashes in SQLite.
# Code-defined per-account/day quotas: 50 teacher, 100 speech requests.
# Global/day: 500 teacher, 1000 speech. In flight: 2/user, 8/process.
# Optional real transactional mail. Leave unset until credentials and a verified
# sender domain are configured. Tests use only a loopback fake provider.
ROTA_MAIL_PROVIDER=
ROTA_MAIL_API_KEY=
ROTA_MAIL_FROM=
# ROTA_MAIL_PROVIDER=resend
# ROTA_MAIL_FROM=Çalışma Rotası <noreply@your-verified-domain.example>
# ROTA_APP_ORIGIN builds the link (fragment token, not query-string token).
# Never set ROTA_MAIL_TEST_URL in production. No real email was sent during development.
